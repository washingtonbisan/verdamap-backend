# =============================================================================
# VerdaMap Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false

# Comma-separated list of allowed frontend origins
# In production, replace with your actual frontend URL
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Public URL of this backend server (used to build image URLs returned to the frontend)
# In production: https://api.yourdomain.com
API_BASE_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
#
# Local development (Docker):
DATABASE_URL=postgresql+asyncpg://verdamap:verdamap@localhost:5432/verdamap
#
# Supabase (production example):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
#
# Neon (production example):
# DATABASE_URL=postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]/[DBNAME]?ssl=require

# ── Sentinel Hub ─────────────────────────────────────────────────────────────
# Get these from: https://apps.sentinel-hub.com/dashboard/#/account/settings
# Click "OAuth clients" → "Create new"
SENTINELHUB_CLIENT_ID=your-client-id-here
SENTINELHUB_CLIENT_SECRET=your-client-secret-here
